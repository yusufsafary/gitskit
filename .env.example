# GitSkit Environment Variables
# Copy to .env and fill in your values

# Password to protect the app (leave empty for open access in dev)
GITSKIT_PASSWORD=your-secure-password-here

# Secret for signing session tokens (generate a random string)
GITSKIT_SECRET=your-random-secret-here-min-32-chars

# xAI API key for transcription (get from x.ai)
XAI_API_KEY=your-xai-api-key-here

# Path to video buckets directory (default: ./videos in project root)
# SYNTAX_BUCKETS_DIR=/absolute/path/to/your/videos

# Optional: FFMPEG binary path if not in PATH
# FFMPEG_PATH=/usr/bin/ffmpeg
